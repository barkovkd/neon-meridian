# Copy to Tools/local.env to set machine-specific options for Tools/unity.sh and Tools/build.sh.
# Tools/local.env is ignored by git.

# Where the work copy of the project lives when the sources sit on an exFAT / FAT volume.
#NEON_WORK_DIR="$HOME/Library/Caches/NeonMeridian/Project"

# Unity editor binary, if it is not the default Hub location for 6000.6.7f1.
#UNITY="/Applications/Unity/Hub/Editor/6000.6.7f1/Unity.app/Contents/MacOS/Unity"

# A wrapper that lets only one heavy job run at a time on this machine. It is called as
#   <script> <who> <command…>
# and must run the command and return its exit code.
#MACHINE_LOCK_SCRIPT="/path/to/machine-lock.sh"
